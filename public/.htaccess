# =======================================================================
# KAGUM - .htaccess untuk Apache / LiteSpeed Web Server
# MIN 1 Purbalingga (https://kagum.min1purbalingga.sch.id)
# =======================================================================

# 1. Pastikan web server selalu memprioritaskan index.php & index.html
DirectoryIndex index.php index.html

# 2. Matikan directory indexing (mencegah munculnya tampilan "Index of /")
Options -Indexes +FollowSymLinks

# 3. Force MIME Types & CORS for JavaScript (ES Modules), CSS, and Assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/zip .zip
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|svg|json|png|jpg|jpeg|ico|woff|woff2|zip)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# 4. URL Rewriting untuk Single Page Application (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika mengakses root domain "/", layani index.php / index.html langsung
  RewriteRule ^$ index.php [L]

  # Biarkan file fisik yang benar-benar ada diakses langsung (api.php, index.php, favicon, css, js, dll)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Biarkan folder assets diakses langsung
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [L]

  # Jangan alihkan file .zip ke index jika tidak ada di disk (return HTTP 404 murni)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.zip$ - [R=404,L]

  # Alihkan semua URL route aplikasi ke index.html (SPA client routing)
  RewriteRule ^ index.html [L]
</IfModule>
